<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.resonance.resonance">

    <!-- ─── Network ──────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ─── Foreground service (media playback) ──────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- ─── FIX: WAKE_LOCK keeps CPU alive when screen is off ────────────── -->
    <!-- Without WAKE_LOCK the OS suspends the audio thread ~30 min after  -->
    <!-- the screen turns off, even if foreground service is running.       -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- ─── FIX: Allow starting after reboot (keeps service persistent) ─── -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- ─── Notifications ────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ─── Audio effects (EQ / bass boost) ─────────────────────────────── -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- ─── Storage (scoped for Android 10+, legacy below) ──────────────── -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>

    <application
        android:label="Resonance"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">

        <!-- ─── FIX: MainActivity now IS the AudioServiceActivity ─────────── -->
        <!-- Previously MainActivity extended FlutterFragmentActivity and      -->
        <!-- AudioServiceActivity was a separate dead entry.  Now MainActivity -->
        <!-- extends AudioServiceActivity (see MainActivity.kt) so this single -->
        <!-- entry handles both the launcher intent AND the MediaSession setup. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ─── audio_service foreground service ─────────────────────────── -->
        <!-- foregroundServiceType="mediaPlayback" is required on Android 10+ -->
        <!-- for the notification to show media controls.                      -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            android:stopWithTask="false">
            <!-- FIX: stopWithTask="false" keeps the service alive when the   -->
            <!-- user swipes the app away — without this the player dies on   -->
            <!-- swipe even if androidStopForegroundOnPause=false is set.     -->
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- ─── Media button receiver (headset / BT buttons) ─────────────── -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- ─── FIX: Boot receiver so the OS knows this app handles media ── -->
        <!-- Some Android OEMs (Xiaomi, Samsung One UI) require              -->
        <!-- RECEIVE_BOOT_COMPLETED + boot receiver to whitelist the          -->
        <!-- foreground service from battery optimisation kills.              -->
        <receiver
            android:name="com.ryanheise.audioservice.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <meta-data android:name="flutterEmbedding" android:value="2"/>
    </application>
</manifest>